# ---------------------------------------------------------------------------
# Agentic EC2 Monitoring Lab - local configuration
#
# Copy this file to `.env` and edit it. `.env` is git-ignored on purpose:
# it is the only place where per-environment values live.
#
#   cp .env.example .env
#
# Precedence used by the CDK app (infrastructure/lab_config.py):
#   1. Real environment variables
#   2. This .env file (does NOT override real env vars)
#   3. cdk.json "context"
#   4. Built-in defaults
#
# The same variables are forwarded to the Lambda function as environment
# variables, so `cdk deploy` is the only step needed to change behaviour.
# ---------------------------------------------------------------------------

# --- Bedrock ---------------------------------------------------------------
# Model used by CrewAI. Must be a Bedrock model that supports the Converse API.
# Default is an Amazon cross-region inference profile (cheap + reasoning capable).
#   Amazon   : us.amazon.nova-2-lite-v1:0 | us.amazon.nova-pro-v1:0
#   Anthropic: us.anthropic.claude-haiku-4-5-20251001-v1:0
#   Amazon   : amazon.nova-lite-v1:0   (direct, single region)
# See README: Configuration before changing this.
BEDROCK_MODEL_ID="us.amazon.nova-2-lite-v1:0"

# Enable Amazon Nova extended thinking on the Diagnosis agent.
BEDROCK_REASONING_ENABLED="true"
# low | medium | high. "high" forces temperature/topP/maxTokens to be unset in
# Bedrock and needs ~50k tokens; it is far too slow/expensive for a 5-minute lab.
BEDROCK_REASONING_EFFORT="low"

# --- Monitoring behaviour --------------------------------------------------
# false -> e-mail only on WARNING/CRITICAL.  true -> e-mail on every run.
ALWAYS_NOTIFY="false"
# Analysis window in minutes. 10 = 2x the schedule interval, because CloudWatch
# publishes datapoints with a 1-3 minute delay and EventBridge Scheduler may fire
# up to ~60s late. Set to 5 for a tighter (sometimes empty) window.
MONITORING_WINDOW_MINUTES="10"
# CPU thresholds in percent. Evaluated against the AVERAGE of the window, not
# the maximum: a single busy datapoint in ten minutes is not an incident, and
# alerting on it would train you to ignore the e-mail.
CPU_WARNING_THRESHOLD="70"
CPU_CRITICAL_THRESHOLD="90"

# --- Schedule --------------------------------------------------------------
# EventBridge Scheduler expression. 5 minutes => 288 runs/day.
SCHEDULE_EXPRESSION="rate(5 minutes)"

# --- Notifications ---------------------------------------------------------
# SNS e-mail subscription. AWS always requires a manual confirmation step.
NOTIFICATION_EMAIL="you@example.com"

# --- EC2 lab instances -----------------------------------------------------
EC2_INSTANCE_TYPE="t3.micro"
EC2_INSTANCE_COUNT="2"
# 1-minute CloudWatch resolution. Required for a meaningful CPU load test.
DETAILED_MONITORING="true"

# --- Lambda ----------------------------------------------------------------
# 3 sequential LLM calls + one extended-thinking call => do not go below 120.
LAMBDA_TIMEOUT_SECONDS="180"
LAMBDA_MEMORY_MB="2048"

# --- Misc ------------------------------------------------------------------
# 1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365. Keeping this explicit makes
# `cdk destroy` delete the log group instead of leaving it behind.
LOG_RETENTION_DAYS="14"

# Stack name prefix.
STACK_NAME="agentic-ec2-monitoring"

# Region used for the stack and for the Lambda/Bedrock calls.
AWS_REGION="us-east-1"
